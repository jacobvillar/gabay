# Gabay environment — names + placeholders only, never real values.
# Copy to .env.local and fill in. All keys are server-side only.

# Groq (open-weight GPT-OSS chat) — free key at https://console.groq.com
GROQ_API_KEY=gsk-your-groq-key

# Upstash Vector index — create it WITH the built-in embedding model text-embedding-3-small
# (1,536 dims, cosine). Upstash embeds server-side, so no embedding key is needed.
UPSTASH_VECTOR_REST_URL=https://your-index.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your-upstash-read-write-token
